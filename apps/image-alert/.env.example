# Copy this file to .env and fill in SMTP_PASS to send real Gmail.
# Without SMTP_PASS the app still works: alerts are saved to data/outbox/.

PORT=3847

# Who the message appears to come from
ALERT_FROM=LensAlert <kaveri.naik@gmail.com>

# Default recipient shown in the UI and used if the form is empty
ALERT_TO=kaveri.naik@gmail.com

# Gmail SMTP — create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=kaveri.naik@gmail.com
SMTP_PASS=

# Server-side cooldown between emails for the same class + recipient (ms)
ALERT_COOLDOWN_MS=60000
