# Copy this file to .env and fill in values to send real email.
# Without SMTP settings the app still works: alerts are saved to data/outbox/.

PORT=3847

# Who the message appears to come from
ALERT_FROM=LensAlert <alerts@example.com>

# Optional default recipient shown in the UI
ALERT_TO=

# SMTP (Gmail: smtp.gmail.com, port 587, use an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Server-side cooldown between emails for the same class + recipient (ms)
ALERT_COOLDOWN_MS=60000
